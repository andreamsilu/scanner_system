@push('scripts')
<script src="https://unpkg.com/html5-qrcode"></script>
<script>
    let html5QrcodeScanner = null;
    let isScannerActive = true;

    function onScanSuccess(decodedText, decodedResult) {
        // Stop scanner
        if (html5QrcodeScanner) {
            html5QrcodeScanner.pause();
        }

        // Show loading state
        const resultsDiv = document.getElementById('qr-reader-results');
        resultsDiv.innerHTML = `
            <div class="alert alert-info d-flex align-items-center">
                <div class="spinner-border spinner-border-sm me-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <span>Validating QR code...</span>
            </div>
        `;

        // Send to backend
        fetch('{{ route('scanner.validate') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': '{{ csrf_token() }}'
            },
            body: JSON.stringify({ token: decodedText })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                resultsDiv.innerHTML = `
                    <div class="alert alert-success d-flex align-items-center">
                        <i class="fas fa-check-circle me-3"></i>
                        <div>
                            <h6 class="alert-heading mb-1">Check-in Successful!</h6>
                            <p class="mb-0">${data.message}</p>
                        </div>
                    </div>
                `;
            } else {
                resultsDiv.innerHTML = `
                    <div class="alert alert-danger d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-3"></i>
                        <div>
                            <h6 class="alert-heading mb-1">Check-in Failed</h6>
                            <p class="mb-0">${data.message}</p>
                        </div>
                    </div>
                `;
            }
        })
        .catch(error => {
            resultsDiv.innerHTML = `
                <div class="alert alert-danger d-flex align-items-center">
                    <i class="fas fa-exclamation-circle me-3"></i>
                    <div>
                        <h6 class="alert-heading mb-1">Error</h6>
                        <p class="mb-0">An error occurred while processing the QR code.</p>
                    </div>
                </div>
            `;
        })
        .finally(() => {
            // Resume scanner after 3 seconds
            setTimeout(() => {
                if (html5QrcodeScanner && isScannerActive) {
                    html5QrcodeScanner.resume();
                }
            }, 3000);
        });
    }

    function onScanFailure(error) {
        // Handle scan failure, usually ignore
        console.warn(`QR code scan error: ${error}`);
    }

    document.addEventListener('DOMContentLoaded', function() {
        const qrReader = document.getElementById('qr-reader');
        const toggleButton = document.getElementById('toggleScanner');

        html5QrcodeScanner = new Html5QrcodeScanner(
            "qr-reader",
            { 
                fps: 10,
                qrbox: { width: 250, height: 250 },
                aspectRatio: 1.0
            },
            false
        );

        html5QrcodeScanner.render(onScanSuccess, onScanFailure);

        toggleButton.addEventListener('click', function() {
            if (isScannerActive) {
                html5QrcodeScanner.pause();
                toggleButton.innerHTML = '<i class="fas fa-play me-2"></i>Start Scanner';
            } else {
                html5QrcodeScanner.resume();
                toggleButton.innerHTML = '<i class="fas fa-pause me-2"></i>Pause Scanner';
            }
            isScannerActive = !isScannerActive;
        });
    });
</script>
@endpush